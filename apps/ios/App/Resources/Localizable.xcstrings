    "payments:payAnyone.err.emvco": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's a Bharat QR. Scan it with your UPI app directly — this reader only understands UPI codes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह Bharat QR है। इसे सीधे अपने UPI ऐप से स्कैन करें — यह रीडर केवल UPI कोड समझता है।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat is een Bharat QR. Scan die rechtstreeks met je UPI-app — deze lezer begrijpt alleen UPI-codes."
          }
        }
      }
    },
    "payments:payAnyone.err.not_upi": {
      "extractionState": "manual",
