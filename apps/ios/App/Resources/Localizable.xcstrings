    "assistant:outFreeRest": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " AI credit top-ups are available on the Lite and Pro plans — upgrade to keep going, then you can buy credits anytime."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": " AI क्रेडिट टॉप-अप Lite और Pro प्लान पर उपलब्ध हैं — जारी रखने के लिए अपग्रेड करें, फिर आप कभी भी क्रेडिट खरीद सकते हैं।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": " AI-creditbundels zijn beschikbaar op de Lite- en Pro-abonnementen — upgrade om door te gaan, daarna kun je altijd credits kopen."
          }
        }
      }
    },
