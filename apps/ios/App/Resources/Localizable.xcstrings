    "accounts:dematNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the total you've put into your demat account. Allocate it across stocks & mutual funds in the Investments section."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आपके डीमैट खाते में डाली गई कुल राशि है। इसे निवेश अनुभाग में शेयरों और म्यूचुअल फंड में आवंटित करें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is het totaal dat je op je demat-rekening hebt gestort. Verdeel het over aandelen en beleggingsfondsen in het gedeelte Beleggingen."
          }
        }
      }
    },
    "accounts:directNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds a silent adjustment so the balance matches — not shown as income/expense."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैलेंस मिलाने के लिए एक मूक समायोजन जोड़ता है — आय/व्यय के रूप में नहीं दिखता।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voegt een stille correctie toe zodat het saldo klopt — niet getoond als inkomsten/uitgaven."
          }
        }
      }
    },
    "accounts:dueDay": {
      "extractionState": "manual",
      "localizations": {
