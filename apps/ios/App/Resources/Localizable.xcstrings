        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ चुनें जिन्हें एक टैप में रखना है। होम और और हमेशा वहीं रहते हैं।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies %1$@ om altijd binnen handbereik te houden. Start en Meer blijven vast."
          }
        }
      }
    },
