    "payments:payAnyone.footnote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the account name in your UPI app before you confirm. Sanvya can't verify who owns a UPI ID."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुष्टि से पहले अपने UPI ऐप में खाता नाम जाँचें। Sanvya यह सत्यापित नहीं कर सकता कि UPI आईडी किसकी है।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer de rekeningnaam in je UPI-app voordat je bevestigt. Sanvya kan niet verifiëren van wie een UPI-ID is."
          }
        }
      }
    },
