    "accounts:allowNegOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transactions that would overdraw this account are blocked."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस खाते को ओवरड्रॉ करने वाले लेनदेन रोक दिए जाते हैं।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transacties die deze rekening in het rood zouden zetten, worden geblokkeerd."
          }
        }
      }
    },
    "accounts:allowNegOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spending can take this account below zero."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खर्च से यह खाता शून्य से नीचे जा सकता है।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitgaven kunnen deze rekening onder nul brengen."
          }
        }
      }
    },
