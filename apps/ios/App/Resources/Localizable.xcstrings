    "settings:guestDelete": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Your data will be deleted in %1$lld day unless you create an account."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Your data will be deleted in %1$lld days unless you create an account."
                }
              }
            }
          }
        },
        "hi": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "जब तक आप खाता नहीं बनाते, आपका डेटा %1$lld दिन में हटा दिया जाएगा।"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "जब तक आप खाता नहीं बनाते, आपका डेटा %1$lld दिनों में हटा दिया जाएगा।"
                }
              }
            }
          }
        },
        "nl": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Je gegevens worden over %1$lld dag verwijderd, tenzij je een account maakt."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Je gegevens worden over %1$lld dagen verwijderd, tenzij je een account maakt."
                }
              }
            }
          }
        }
      }
