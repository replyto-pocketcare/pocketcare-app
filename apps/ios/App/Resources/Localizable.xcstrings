    "payments:confirm.receivedInto": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Received into"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसमें प्राप्त हुआ"
          }
        },
        "nl": {
