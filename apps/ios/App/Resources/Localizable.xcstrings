    "payments:confirm.reference": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reference %1$@ — look for this in your bank statement"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
