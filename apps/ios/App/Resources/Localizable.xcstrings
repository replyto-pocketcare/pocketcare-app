    "receipts:capture.improveWithAi": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Improve with AI"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI से बेहतर करें"
          }
        },
        "nl": {
