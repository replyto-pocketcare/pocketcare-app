    "investments:eodNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listed prices are end-of-day%1$@. Unlisted schemes (crypto, FDs, off-list) use the current value you enter, else cost."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूचीबद्ध कीमतें दिन-के-अंत की हैं%1$@। असूचीबद्ध योजनाएँ (क्रिप्टो, एफडी, ऑफ-लिस्ट) आपके द्वारा दर्ज वर्तमान मूल्य का उपयोग करती हैं, अन्यथा लागत का।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Genoteerde koersen zijn eindedagkoersen%1$@. Niet-genoteerde regelingen (crypto, deposito's, off-list) gebruiken de huidige waarde die je invoert, anders de kostprijs."
          }
        }
      }
    },
    "investments:existingNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No money leaves your accounts — this only records an investment you already own."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके खातों से कोई पैसा नहीं निकलता — यह केवल आपके पास पहले से मौजूद निवेश को दर्ज करता है।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er verlaat geen geld je rekeningen — dit legt alleen een belegging vast die je al bezit."
          }
        }
      }
    },
