    "groups:noGroupsBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a trip or group, then invite friends by link. Once they join you can split expenses."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक यात्रा या समूह बनाएं, फिर लिंक द्वारा मित्रों को आमंत्रित करें। उनके शामिल होने पर आप खर्च बाँट सकते हैं।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak een reis of groep en nodig vrienden uit via een link. Zodra ze meedoen, kun je uitgaven splitsen."
          }
        }
      }
    },
