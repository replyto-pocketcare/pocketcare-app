    "investments:sipNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On each SIP date we record a transfer of %1$@ from that account into %2$@ — it shows under Recurring & Planned Cashflow too."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर एसआईपी तिथि पर हम उस खाते से %2$@ में %1$@ का स्थानांतरण दर्ज करते हैं — यह आवर्ती और नियोजित नकदी प्रवाह में भी दिखता है।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op elke SIP-datum leggen we een overboeking van %1$@ van die rekening naar %2$@ vast — het verschijnt ook onder Terugkerend & Geplande cashflow."
          }
        }
      }
    },
    "investments:syncNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live prices appear once the daily market sync runs; unlisted schemes use the value you enter, else cost."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दैनिक बाज़ार सिंक चलने पर लाइव कीमतें दिखती हैं; असूचीबद्ध योजनाएँ आपके दर्ज मूल्य का उपयोग करती हैं, अन्यथा लागत का।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Live koersen verschijnen zodra de dagelijkse marktsync draait; niet-genoteerde regelingen gebruiken de waarde die je invoert, anders de kostprijs."
          }
        }
      }
    },
