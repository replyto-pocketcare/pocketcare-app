        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "EMI देय होते ही इसी खाते में अपने आप दर्ज हो जाएगी।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zodra een termijn vervalt wordt hij automatisch op deze rekening geboekt."
          }
        }
      }
