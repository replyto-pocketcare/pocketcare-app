    "assistant:errModel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The configured AI model isn't available on your account. Set the ASSISTANT_MODEL secret to a valid Anthropic model id (e.g. claude-3-5-haiku-20241022)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉन्फ़िगर किया गया AI मॉडल आपके खाते पर उपलब्ध नहीं है। ASSISTANT_MODEL सीक्रेट को एक मान्य Anthropic मॉडल आईडी पर सेट करें (जैसे claude-3-5-haiku-20241022)।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het geconfigureerde AI-model is niet beschikbaar op je account. Stel het ASSISTANT_MODEL-secret in op een geldig Anthropic-model-id (bijv. claude-3-5-haiku-20241022)."
          }
        }
      }
    },
    "assistant:errNetwork": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I couldn't reach the assistant — check your connection and try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं असिस्टेंट तक नहीं पहुँच सका — अपना कनेक्शन जाँचें और पुनः प्रयास करें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik kon de assistent niet bereiken — controleer je verbinding en probeer opnieuw."
          }
        }
      }
    },
