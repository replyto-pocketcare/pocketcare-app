    "receipts:capture.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photograph a restaurant bill or grocery receipt and we'll turn it into a transaction — item by item."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रेस्तराँ का बिल या किराने की रसीद की फ़ोटो लें — हम उसे वस्तु-दर-वस्तु लेन-देन में बदल देंगे।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak een foto van een restaurantrekening of boodschappenbon en wij maken er een transactie van — artikel voor artikel."
          }
        }
      }
    },
    "receipts:capture.noCredits": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're out of AI credits this month. You can still edit the receipt by hand."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस महीने आपके AI क्रेडिट ख़त्म हो गए हैं। आप रसीद को हाथ से भी ठीक कर सकते हैं।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je AI-tegoed voor deze maand is op. Je kunt de bon nog wel handmatig aanpassen."
          }
        }
      }
    },
