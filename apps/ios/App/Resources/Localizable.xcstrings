    "onboarding:slides.0.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your calm money companion — track spending, plan ahead, and reach your goals, all in one private place that works offline."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका शांत धन साथी — खर्च ट्रैक करें, आगे की योजना बनाएं, और अपने लक्ष्य पाएं, सब एक निजी जगह में जो ऑफ़लाइन काम करती है।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je rustige geldmaatje — houd uitgaven bij, plan vooruit en bereik je doelen, allemaal op één privéplek die offline werkt."
          }
        }
      }
    },
    "onboarding:slides.0.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meet Sanvya"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanvya से मिलें"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak kennis met Sanvya"
          }
        }
      }
    },
    "onboarding:slides.1.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add your bank, cash and cards so Sanvya knows your starting balances. This one step powers everything else — your net worth, budgets and insights."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने बैंक, नकद और कार्ड जोड़ें ताकि Sanvya आपके शुरुआती बैलेंस जान सके। यह एक कदम बाकी सब कुछ चलाता है — आपकी नेट वर्थ, बजट और इनसाइट्स।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg je bank, contant geld en kaarten toe zodat Sanvya je beginsaldi kent. Deze ene stap voedt al het andere — je nettowaarde, budgetten en inzichten."
          }
        }
      }
    },
    "onboarding:slides.1.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start here: add your accounts"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ से शुरू करें: अपने खाते जोड़ें"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin hier: voeg je rekeningen toe"
          }
        }
      }
    },
    "onboarding:slides.2.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record what you spend or earn — type it, or just tap the mic and say it out loud. Sanvya even suggests the category for you."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो आप खर्च या कमाते हैं उसे दर्ज करें — टाइप करें, या बस माइक टैप करें और बोलें। Sanvya आपके लिए श्रेणी भी सुझाता है।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg vast wat je uitgeeft of verdient — typ het, of tik gewoon op de microfoon en zeg het hardop. Sanvya stelt zelfs de categorie voor je voor."
          }
        }
      }
    },
    "onboarding:slides.2.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log money in seconds"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेकंडों में पैसा दर्ज करें"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg geld in seconden vast"
          }
        }
      }
    },
    "onboarding:slides.3.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set simple budgets that nudge you early, and see clear, beautiful insights into where your money actually goes each month."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सरल बजट सेट करें जो आपको जल्दी सचेत करें, और हर महीने आपका पैसा वास्तव में कहाँ जाता है इसकी स्पष्ट, सुंदर इनसाइट्स देखें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel eenvoudige budgetten in die je vroeg attent maken, en zie heldere, mooie inzichten in waar je geld elke maand echt naartoe gaat."
          }
        }
      }
    },
    "onboarding:slides.3.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Know where it goes"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जानें यह कहाँ जाता है"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weet waar het naartoe gaat"
          }
        }
      }
    },
    "onboarding:slides.4.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Salary, rent, bills, EMIs and subscriptions in one view — so upcoming payments never take you by surprise."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वेतन, किराया, बिल, ईएमआई और सदस्यताएँ एक ही जगह — ताकि आगामी भुगतान कभी आपको चौंकाएँ नहीं।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Salaris, huur, rekeningen, EMI's en abonnementen in één overzicht — zodat aankomende betalingen je nooit verrassen."
          }
        }
      }
    },
    "onboarding:slides.4.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan what's coming"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आगे क्या आ रहा है, योजना बनाएं"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan wat eraan komt"
          }
        }
      }
    },
    "onboarding:slides.5.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build an emergency buffer first, then set money aside for what matters and see exactly when you'll get there."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले एक आपातकालीन बफ़र बनाएं, फिर जो मायने रखता है उसके लिए पैसा अलग रखें और ठीक-ठीक देखें कि आप कब वहाँ पहुँचेंगे।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bouw eerst een noodbuffer op, zet dan geld opzij voor wat belangrijk is en zie precies wanneer je er komt."
          }
        }
      }
    },
    "onboarding:slides.5.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reach your goals"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने लक्ष्य पाएं"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereik je doelen"
          }
        }
      }
    },
    "onboarding:slides.6.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask Sanvya in plain words — \"where did my money go?\", \"can I afford this?\" — and it'll answer or take you right to the screen."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanvya से सरल शब्दों में पूछें — \"मेरा पैसा कहाँ गया?\", \"क्या मैं यह वहन कर सकता हूँ?\" — और यह उत्तर देगा या आपको सीधे स्क्रीन पर ले जाएगा।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraag Sanvya in gewone taal — \"waar ging mijn geld heen?\", \"kan ik dit betalen?\" — en het antwoordt of brengt je meteen naar het scherm."
          }
        }
      }
    },
    "onboarding:slides.6.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not sure? Just ask"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पक्का नहीं? बस पूछें"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet zeker? Vraag het gewoon"
          }
        }
      }
    },
    "onboarding:starting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starting…"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शुरू हो रहा है…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Starten…"
          }
        }
      }
    },
    "onboarding:tryGuest": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try as guest"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अतिथि के रूप में आज़माएँ"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als gast proberen"
          }
        }
      }
    },
    "onboarding:wt.acc.balHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An approximate number is fine — you can correct it any time."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अंदाज़न रकम ठीक है — आप इसे कभी भी सुधार सकते हैं।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een schatting is prima — je kunt het altijd corrigeren."
          }
        }
      }
    },
    "onboarding:wt.acc.balLabel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Roughly how much is in it now?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी इसमें लगभग कितना है?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoeveel staat er ongeveer op?"
          }
        }
      }
    },
    "onboarding:wt.acc.cta": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजें"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opslaan"
          }
        }
      }
    },
    "onboarding:wt.acc.eg1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HDFC savings"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "HDFC बचत"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "HDFC spaarrekening"
          }
        }
      }
    },
    "onboarding:wt.acc.eg2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cash in purse"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पर्स की नकदी"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Contant in portemonnee"
          }
        }
      }
    },
    "onboarding:wt.acc.nameLabel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give it a name"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे एक नाम दें"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef het een naam"
          }
        }
      }
    },
    "onboarding:wt.acc.p1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An \"account\" here is just your own note of somewhere money sits — your bank, the cash in your purse, a credit card. It's a name and a number you type. Nothing is linked to the real bank."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ \"खाता\" बस आपका अपना नोट है कि पैसा कहाँ रखा है — आपका बैंक, पर्स की नकदी, कोई क्रेडिट कार्ड। यह सिर्फ़ एक नाम और एक रकम है जो आप लिखते हैं। असली बैंक से कुछ भी नहीं जुड़ता।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een \"rekening\" is hier gewoon je eigen aantekening van waar geld staat — je bank, het contant in je portemonnee, een creditcard. Het is een naam en een bedrag dat jij typt. Er wordt niets aan de echte bank gekoppeld."
          }
        }
      }
    },
    "onboarding:wt.acc.p2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with the one you use most. You can add others later."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिसे सबसे ज़्यादा इस्तेमाल करते हैं उसी से शुरू करें। बाकी बाद में जोड़ सकते हैं।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin met degene die je het meest gebruikt. De rest kun je later toevoegen."
          }
        }
      }
    },
    "onboarding:wt.acc.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where do you keep your money?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप अपना पैसा कहाँ रखते हैं?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waar bewaar je je geld?"
          }
        }
      }
    },
    "onboarding:wt.ask.p1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type or say things like \"how much did I spend on groceries last month?\" or \"can I afford ₹15,000 this week?\" — and it answers from your own entries."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐसे लिखें या बोलें — \"पिछले महीने राशन पर कितना खर्च हुआ?\" या \"क्या इस हफ़्ते ₹15,000 खर्च कर सकता हूँ?\" — और यह आपकी अपनी entries से जवाब देगा।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typ of zeg dingen als \"hoeveel gaf ik vorige maand uit aan boodschappen?\" of \"kan ik deze week ₹15.000 missen?\" — en het antwoordt op basis van je eigen aantekeningen."
          }
        }
      }
    },
    "onboarding:wt.ask.p2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No menus to learn. If you'd rather ask a question than hunt for a screen, this is the shortcut."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई मेन्यू सीखने की ज़रूरत नहीं। अगर स्क्रीन ढूँढने से आसान सवाल पूछना लगता है, तो यही रास्ता है।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen menu's om te leren. Als je liever een vraag stelt dan een scherm zoekt, is dit de kortere weg."
          }
        }
      }
    },
    "onboarding:wt.ask.privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It only ever reads your own entries, and nothing is sent anywhere until you ask it something."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सिर्फ़ आपकी अपनी entries पढ़ता है, और जब तक आप कुछ पूछते नहीं, कुछ भी कहीं नहीं भेजा जाता।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het leest alleen je eigen aantekeningen, en er wordt niets verstuurd totdat jij iets vraagt."
          }
        }
      }
    },
    "onboarding:wt.ask.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Or just ask, in your own words"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "या अपने ही शब्दों में पूछ लीजिए"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Of vraag het gewoon, in je eigen woorden"
          }
        }
      }
    },
    "onboarding:wt.dialogLabel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Getting started with Sanvya"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanvya की शुरुआत"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aan de slag met Sanvya"
          }
        }
      }
    },
    "onboarding:wt.done.budgetBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set a monthly limit and Sanvya tells you when to slow down."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "महीने की सीमा तय करें और Sanvya बताएगा कि कब रुकना है।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel een maandlimiet in en Sanvya zegt wanneer je moet afremmen."
          }
        }
      }
    },
    "onboarding:wt.done.budgetTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Budgets"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बजट"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Budgetten"
          }
        }
      }
    },
    "onboarding:wt.done.cta": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरा हुआ"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afronden"
          }
        }
      }
    },
    "onboarding:wt.done.dashBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your money at a glance."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके पैसों की एक झलक।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je geld in één oogopslag."
          }
        }
      }
    },
    "onboarding:wt.done.dashTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dashboard"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डैशबोर्ड"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dashboard"
          }
        }
      }
    },
    "onboarding:wt.done.more": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See what else it does →"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "और क्या कर सकता है, देखें →"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk wat het nog meer doet →"
          }
        }
      }
    },
    "onboarding:wt.done.privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data is yours. It stays on your device and in your private account — we don't share it, and nobody else can see it."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका डेटा आपका है। यह आपके डिवाइस और आपके निजी खाते में रहता है — हम इसे साझा नहीं करते, और कोई और इसे नहीं देख सकता।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je gegevens zijn van jou. Ze blijven op je apparaat en in je eigen account — we delen ze niet, en niemand anders kan ze zien."
          }
        }
      }
    },
    "onboarding:wt.done.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's it — you're set up"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बस — आपका सेटअप हो गया"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klaar — je bent ingesteld"
          }
        }
      }
    },
    "onboarding:wt.done.txnBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything you've written down."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने जो कुछ लिखा है, सब यहाँ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles wat je hebt opgeschreven."
          }
        }
      }
    },
    "onboarding:wt.done.txnTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transactions"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लेनदेन"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transacties"
          }
        }
      }
    },
    "onboarding:wt.guest.cta": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a free account"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मुफ़्त खाता बनाएँ"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis account maken"
          }
        }
      }
    },
    "onboarding:wt.guest.later": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Later"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बाद में"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Later"
          }
        }
      }
    },
    "onboarding:wt.guest.p1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your entries live only on this device, and guest data is deleted after a few days. Create a free account to keep it — and you'll get 14 days with everything unlocked."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी entries सिर्फ़ इसी डिवाइस पर हैं, और मेहमान डेटा कुछ दिनों बाद मिटा दिया जाता है। इसे बचाने के लिए मुफ़्त खाता बनाइए — और 14 दिन सब कुछ खुला मिलेगा।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je aantekeningen staan alleen op dit apparaat, en gastgegevens worden na een paar dagen verwijderd. Maak een gratis account om ze te bewaren — en je krijgt 14 dagen met alles ontgrendeld."
          }
        }
      }
    },
    "onboarding:wt.guest.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're using Sanvya as a guest"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप Sanvya मेहमान के रूप में इस्तेमाल कर रहे हैं"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je gebruikt Sanvya als gast"
          }
        }
      }
    },
    "onboarding:wt.insights.eg": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"You've spent 32% more on eating out this month than last.\""
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"इस महीने बाहर खाने पर आपने पिछले महीने से 32% ज़्यादा खर्च किया है।\""
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Je hebt deze maand 32% meer aan uit eten gegeven dan vorige maand.\""
          }
        }
      }
    },
    "onboarding:wt.insights.p1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once you've written a few things down, Sanvya starts pointing things out on its own: which category is eating the most, a month running hotter than the last, a subscription you may have forgotten."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ चीज़ें लिख लेने के बाद Sanvya खुद बताने लगता है: किस श्रेणी में सबसे ज़्यादा जा रहा है, कौन सा महीना पिछले से भारी है, कोई सदस्यता जो शायद आप भूल गए हों।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zodra je een paar dingen hebt opgeschreven, begint Sanvya zelf dingen aan te wijzen: welke categorie het meest opslokt, een maand die harder loopt dan de vorige, een abonnement dat je misschien vergeten was."
          }
        }
      }
    },
    "onboarding:wt.insights.p2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You don't have to build a single chart or spreadsheet. The more you write down, the more it has to tell you."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपको कोई चार्ट या स्प्रेडशीट नहीं बनानी। जितना ज़्यादा लिखेंगे, उतना ज़्यादा यह बता पाएगा।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hoeft geen enkele grafiek of spreadsheet te maken. Hoe meer je opschrijft, hoe meer het je kan vertellen."
          }
        }
      }
    },
    "onboarding:wt.insights.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanvya reads your entries back to you"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanvya आपकी अपनी entries से नतीजे निकालता है"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanvya leest je eigen aantekeningen terug"
          }
        }
      }
    },
    "onboarding:wt.intro.cta": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show me how"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मुझे दिखाइए"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat maar zien"
          }
        }
      }
    },
    "onboarding:wt.intro.p1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanvya is your private money diary. You write down what you spend and earn, and it shows you where your money is actually going."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanvya आपकी निजी पैसों की डायरी है। आप जो खर्च और कमाई लिखते हैं, उसी से यह दिखाता है कि आपका पैसा असल में कहाँ जा रहा है।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanvya is je persoonlijke geld-dagboek. Je schrijft op wat je uitgeeft en verdient, en het laat zien waar je geld werkelijk heen gaat."
          }
        }
      }
    },
    "onboarding:wt.intro.p2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is not connected to your bank."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आपके बैंक से जुड़ा हुआ नहीं है।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is niet gekoppeld aan je bank."
          }
        }
      }
    },
    "onboarding:wt.intro.p3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We never ask for your bank login, card number or OTP, and we can't see your bank at all."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम कभी आपका बैंक लॉगिन, कार्ड नंबर या OTP नहीं माँगते, और हम आपका बैंक देख ही नहीं सकते।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We vragen nooit om je bankinlog, kaartnummer of OTP, en we kunnen je bank helemaal niet zien."
          }
        }
      }
    },
    "onboarding:wt.intro.p4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is tracked automatically — you'll type your spends in yourself. That's deliberate: the few seconds it takes is what makes you notice where your money goes, and noticing is the whole point."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ भी अपने आप दर्ज नहीं होता — खर्च आप खुद लिखेंगे। यह जानबूझकर है: उन कुछ सेकंडों में ही आपका ध्यान जाता है कि पैसा कहाँ जा रहा है, और यही असली मकसद है।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wordt niets automatisch bijgehouden — je typt je uitgaven zelf in. Dat is met opzet: juist die paar seconden zorgen ervoor dat je merkt waar je geld heen gaat, en dat merken is het hele punt."
          }
        }
      }
    },
    "onboarding:wt.intro.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome to Sanvya"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanvya में आपका स्वागत है"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Welkom bij Sanvya"
          }
        }
      }
    },
    "onboarding:wt.later": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skip this for now"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी रहने दें"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu even niet"
          }
        }
      }
    },
    "onboarding:wt.next": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आगे"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volgende"
          }
        }
      }
    },
    "onboarding:wt.plan.cta": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरा हुआ"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klaar"
          }
        }
      }
    },
    "onboarding:wt.plan.free": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The basics stay free forever: your accounts, transactions, budgets and search."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बुनियादी चीज़ें हमेशा मुफ़्त रहेंगी: आपके खाते, लेनदेन, बजट और खोज।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De basis blijft voor altijd gratis: je rekeningen, transacties, budgetten en zoeken."
          }
        }
      }
    },
    "onboarding:wt.plan.perMonth": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "₹%1$@/month"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "₹%1$@/माह"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "₹%1$@/maand"
          }
        }
      }
    },
    "onboarding:wt.plan.quota": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Ask Sanvya questions a month · everything else unlocked"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "महीने में %1$@ Ask Sanvya सवाल · बाकी सब खुला"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Ask Sanvya-vragen per maand · al het andere ontgrendeld"
          }
        }
      }
    },
    "onboarding:wt.plan.see": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See plans"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्लान देखें"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk abonnementen"
          }
        }
      }
    },
    "onboarding:wt.plan.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What's free, and what's not"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या मुफ़्त है, और क्या नहीं"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat gratis is, en wat niet"
          }
        }
      }
    },
    "onboarding:wt.plan.titleTrial": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything is already unlocked for 14 days"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "14 दिन तक सब कुछ पहले से खुला है"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles staat al 14 dagen open"
          }
        }
      }
    },
    "onboarding:wt.plan.trial": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Insights, Ask Sanvya and Statements are on right now — no card, nothing to set up. Use them and see whether they're worth it to you."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Insights, Ask Sanvya और Statements अभी चालू हैं — न कार्ड चाहिए, न कुछ सेट करना है। इस्तेमाल करके देखिए कि ये आपके काम के हैं या नहीं।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Insights, Ask Sanvya en Statements staan nu aan — geen kaart, niets in te stellen. Gebruik ze en kijk of ze het je waard zijn."
          }
        }
      }
    },
    "onboarding:wt.progress": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step %1$@ of %2$@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चरण %1$@ / %2$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stap %1$@ van %2$@"
          }
        }
      }
    },
    "onboarding:wt.saving": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving…"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजा जा रहा है…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opslaan…"
          }
        }
      }
    },
    "onboarding:wt.skip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'll look around myself"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं खुद देख लूँगा"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik kijk zelf rond"
          }
        }
      }
    },
    "onboarding:wt.spend.amountLabel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How much?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कितने का?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoeveel?"
          }
        }
      }
    },
    "onboarding:wt.spend.cta": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजें"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opslaan"
          }
        }
      }
    },
    "onboarding:wt.spend.p1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Think of the last thing you paid for — tea, groceries, a bill."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछली बार जो चीज़ आपने खरीदी थी सोचिए — चाय, राशन, कोई बिल।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Denk aan het laatste waarvoor je betaalde — thee, boodschappen, een rekening."
          }
        }
      }
    },
    "onboarding:wt.spend.p2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you record a spend, Sanvya subtracts it from that account, so the number stays true to real life."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आप खर्च दर्ज करते हैं, Sanvya उसे उस खाते से घटा देता है, ताकि रकम असल ज़िंदगी से मेल खाती रहे।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je een uitgave vastlegt, trekt Sanvya die van die rekening af, zodat het bedrag klopt met de werkelijkheid."
          }
        }
      }
    },
    "onboarding:wt.spend.p3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the one habit that matters — everything else in the app is built from it."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यही एक आदत सबसे ज़रूरी है — ऐप का बाकी सब कुछ इसी पर बना है।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is de gewoonte die telt — al het andere in de app is hierop gebouwd."
          }
        }
      }
    },
    "onboarding:wt.spend.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now write down one thing you spent"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब एक खर्च लिखिए"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijf nu één uitgave op"
          }
        }
      }
    },
    "onboarding:wt.spend.whatEg": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Groceries"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "राशन"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Boodschappen"
          }
        }
      }
    },
    "onboarding:wt.spend.whatLabel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What was it for?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किस चीज़ के लिए था?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waarvoor was het?"
          }
        }
      }
    },
    "payments:confirm.claim": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ says they paid you"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ का कहना है कि उन्होंने आपको भुगतान किया"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ zegt je te hebben betaald"
          }
        }
      }
    },
    "payments:confirm.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We can't see UPI transfers, so please check your bank before confirming."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम UPI ट्रांसफ़र नहीं देख सकते, इसलिए पुष्टि से पहले अपना बैंक ज़रूर जाँच लें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wij kunnen UPI-overboekingen niet zien, dus controleer je bank voordat je bevestigt."
          }
        }
      }
    },
    "payments:confirm.no": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Didn't arrive"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नहीं आया"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet aangekomen"
          }
        }
      }
    },
    "payments:confirm.noAccount": {
      "extractionState": "manual",
      "localizations": {
