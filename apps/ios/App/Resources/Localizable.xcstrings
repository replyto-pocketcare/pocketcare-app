    "onboarding:footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create an account to sync across devices. Guest data stays on this device and is kept for 3 days."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उपकरणों में सिंक करने के लिए एक खाता बनाएं। अतिथि डेटा इसी उपकरण पर रहता है और 3 दिनों तक रखा जाता है।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak een account om op alle apparaten te synchroniseren. Gastgegevens blijven op dit apparaat en worden 3 dagen bewaard."
          }
        }
      }
    },
