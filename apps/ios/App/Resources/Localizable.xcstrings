        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jouw UPI-ID"
          }
        }
      }
    },
    "payments:settings.guestBlocked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create an account to add a UPI ID. Guest sessions can't save payment details."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "UPI ID जोड़ने के लिए खाता बनाएँ। अतिथि सत्र में भुगतान विवरण सहेजे नहीं जा सकते।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak een account aan om een UPI-ID toe te voegen. In een gastsessie kunnen geen betaalgegevens worden opgeslagen."
          }
        }
      }
    },
    "payments:settings.hideLog": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide access log"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक्सेस लॉग छिपाएँ"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toegangslog verbergen"
          }
        }
      }
    },
    "payments:settings.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add your UPI ID so friends can pay you back from inside Sanvya. Money goes straight to your bank — we never hold it."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी UPI ID जोड़ें ताकि दोस्त Sanvya से ही आपको पैसे लौटा सकें। पैसा सीधे आपके बैंक में जाता है — हम उसे कभी नहीं रखते।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg je UPI-ID toe zodat vrienden je vanuit Sanvya kunnen terugbetalen. Het geld gaat rechtstreeks naar je bank — wij houden het nooit vast."
          }
        }
      }
    },
    "payments:settings.invalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That doesn't look right — a UPI ID looks like name@bank."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सही नहीं लगता — UPI ID ऐसी होती है: name@bank।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat ziet er niet goed uit — een UPI-ID ziet eruit als naam@bank."
          }
        }
      }
    },
    "payments:settings.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UPI ID"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "UPI ID"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "UPI-ID"
          }
        }
      }
    },
    "payments:settings.privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shared only with people you're in a group with and have a balance with — and only when they go to pay you. Unlike your passphrase-protected data, our server can read this, because it has to hand it to the payer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सिर्फ़ उन्हीं लोगों से साझा होती है जिनके साथ आप किसी समूह में हैं और जिनसे लेन-देन बकाया है — और तभी जब वे आपको भुगतान करने जाएँ। आपके पासफ़्रेज़-सुरक्षित डेटा के विपरीत, हमारा सर्वर इसे पढ़ सकता है, क्योंकि उसे यह भुगतानकर्ता को देनी होती है।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt alleen gedeeld met mensen met wie je in een groep zit én een openstaand saldo hebt — en alleen wanneer zij je gaan betalen. Anders dan je met een wachtwoordzin beschermde gegevens kan onze server dit lezen, omdat hij het aan de betaler moet doorgeven."
          }
        }
      }
    },
    "payments:settings.remove": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
