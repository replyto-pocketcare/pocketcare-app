        "hi": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "इसमें %1$lld आइटम है। चुनें कि इसे कहाँ ले जाना है — कुछ भी बिना समूह के नहीं रह सकता।"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "इसमें %1$lld आइटम हैं। चुनें कि इन्हें कहाँ ले जाना है — कुछ भी बिना समूह के नहीं रह सकता।"
                }
              }
            }
          }
        },
        "nl": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Er zit %1$lld item in. Kies waar het heen moet — niets mag zonder groep blijven."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Er zitten %1$lld items in. Kies waar ze heen moeten — niets mag zonder groep blijven."
                }
              }
            }
          }
        }
      }
