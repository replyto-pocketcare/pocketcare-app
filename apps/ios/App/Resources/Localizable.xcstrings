    "data:footerNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New accounts and categories are created automatically (accounts default to “savings” — you can change the type afterward). Importing recomputes balances from your ledger. The Wallet by BudgetBakers importer is in beta — transfers may need a quick review."
