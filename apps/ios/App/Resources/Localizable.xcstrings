      }
    },
    "assistant:privacyBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We never share PII or email. Anthropic is contractually bound to NOT use your data for model training. However, please avoid typing personally identifiable information (PII) like account numbers or exact names in the chat."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम कभी PII या ईमेल साझा नहीं करते। Anthropic अनुबंध द्वारा बाध्य है कि आपके डेटा का उपयोग मॉडल प्रशिक्षण के लिए न करे। फिर भी, कृपया चैट में खाता संख्या या सटीक नाम जैसी व्यक्तिगत पहचान योग्य जानकारी (PII) टाइप करने से बचें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We delen nooit PII of e-mail. Anthropic is contractueel verplicht je gegevens NIET te gebruiken voor modeltraining. Vermijd echter het typen van persoonlijk identificeerbare informatie (PII) zoals rekeningnummers of exacte namen in de chat."
          }
        }
      }
    },
