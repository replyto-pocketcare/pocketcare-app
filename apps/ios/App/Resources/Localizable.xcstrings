    "loans:variableEditNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Variable-rate loan — enter each month's EMI on the loan's schedule below. The single EMI field is disabled."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "परिवर्तनीय-दर ऋण — नीचे ऋण के शेड्यूल में हर महीने की ईएमआई दर्ज करें। एकल ईएमआई फ़ील्ड अक्षम है।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lening met variabele rente — voer elke maand de EMI in in het schema hieronder. Het enkele EMI-veld is uitgeschakeld."
          }
        }
      }
    },
    "loans:variableNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Variable-rate loans re-price over time, so enter each month's EMI as your bank sets it. "
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "परिवर्तनीय-दर ऋण समय के साथ पुनर्मूल्यित होते हैं, इसलिए हर महीने की ईएमआई वैसे दर्ज करें जैसे आपका बैंक तय करता है। "
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leningen met variabele rente worden na verloop van tijd opnieuw geprijsd, dus voer elke maand de EMI in zoals je bank die bepaalt. "
          }
        }
      }
    },
    "loans:variableNoteBold": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "enter each month's EMI"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर महीने की ईएमआई दर्ज करें"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "elke maand de EMI in te voeren"
          }
        }
      }
    },
