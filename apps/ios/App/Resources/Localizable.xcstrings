    "receipts:capture.dropHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Or drop an image or PDF here. JPEG, PNG or a PDF bill."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "या यहाँ इमेज या PDF छोड़ें। JPEG, PNG या PDF बिल।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
