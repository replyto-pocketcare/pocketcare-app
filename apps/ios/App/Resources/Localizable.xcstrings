    "assistant:landingIntro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan a purchase or savings goal in plain language. Only an aggregated summary of your finances is shared — never individual transactions. The assistant can make mistakes: it's here to help you think, so double-check important numbers and use your own judgment."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सरल भाषा में खरीदारी या बचत लक्ष्य की योजना बनाएं। केवल आपके वित्त का एक समग्र सारांश साझा किया जाता है — कभी व्यक्तिगत लेनदेन नहीं। असिस्टेंट गलतियाँ कर सकता है: यह आपको सोचने में मदद के लिए है, इसलिए महत्वपूर्ण संख्याओं की दोबारा जाँच करें और अपने विवेक का उपयोग करें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan een aankoop of spaardoel in gewone taal. Alleen een geaggregeerd overzicht van je financiën wordt gedeeld — nooit individuele transacties. De assistent kan fouten maken: hij is er om je te helpen nadenken, dus controleer belangrijke getallen dubbel en gebruik je eigen oordeel."
          }
        }
      }
    },
    "assistant:newChat": {
      "extractionState": "manual",
