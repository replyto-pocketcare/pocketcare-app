          "stringUnit": {
            "state": "translated",
            "value": "साप्ताहिक सारांश, बजट अलर्ट, खर्च के पैटर्न और बचत की जीतें छोटे-छोटे कार्ड के रूप में — एक प्रीमियम सुविधा।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wekelijkse samenvattingen, budgetwaarschuwingen, uitgavenpatronen en spaarsuccessen als hapklare kaarten — een Premium-functie."
