    "templates:introPre": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Templates are one-tap shortcuts for transactions you log often. For salary, rent and other automatic schedules, use "
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टेम्पलेट उन लेनदेन के लिए एक-टैप शॉर्टकट हैं जिन्हें आप अक्सर दर्ज करते हैं। वेतन, किराया और अन्य स्वचालित शेड्यूल के लिए, उपयोग करें "
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sjablonen zijn snelkoppelingen met één tik voor transacties die je vaak vastlegt. Voor salaris, huur en andere automatische schema's gebruik je "
          }
        }
      }
    },
    "templates:limitMsg": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free plans can keep up to %1$@ templates. Upgrade to Premium for unlimited templates."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मुफ़्त प्लान अधिकतम %1$@ टेम्पलेट रख सकते हैं। असीमित टेम्पलेट के लिए प्रीमियम में अपग्रेड करें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis abonnementen kunnen tot %1$@ sjablonen bewaren. Upgrade naar Premium voor onbeperkte sjablonen."
          }
        }
      }
