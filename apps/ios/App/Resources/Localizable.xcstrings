      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UPI only supports payments in rupees."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "UPI केवल रुपये में भुगतान करता है।"
