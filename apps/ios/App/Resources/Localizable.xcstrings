    "accounts:convertedNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Converted to %1$@ at the latest exchange rate. Accounts stay in their own currency."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नवीनतम विनिमय दर पर %1$@ में परिवर्तित। खाते अपनी-अपनी मुद्रा में रहते हैं।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omgerekend naar %1$@ tegen de meest recente wisselkoers. Rekeningen blijven in hun eigen valuta."
          }
        }
