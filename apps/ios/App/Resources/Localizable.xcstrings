    "settings:guestSignoutWarn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're signed in as a guest. Signing out will permanently delete your data — your accounts, transactions, budgets and goals. You'll start from scratch and have to enter everything again next time. Create an account first to keep it."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप एक अतिथि के रूप में साइन इन हैं। साइन आउट करने से आपका डेटा — आपके खाते, लेनदेन, बजट और लक्ष्य — स्थायी रूप से हट जाएगा। आपको फिर से शुरू करना होगा और अगली बार सब कुछ दोबारा दर्ज करना होगा। इसे रखने के लिए पहले खाता बनाएं।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent aangemeld als gast. Afmelden verwijdert je gegevens permanent — je rekeningen, transacties, budgetten en doelen. Je begint opnieuw en moet de volgende keer alles opnieuw invoeren. Maak eerst een account om het te bewaren."
          }
        }
      }
    },
    "settings:help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Help & Support"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहायता और समर्थन"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Help & ondersteuning"
          }
        }
      }
    },
    "settings:helpNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanvya · your data is stored on your device and synced securely. Guest data is removed after 3 days if you don't register."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanvya · आपका डेटा आपके उपकरण पर संग्रहीत है और सुरक्षित रूप से सिंक होता है। यदि आप पंजीकरण नहीं करते तो अतिथि डेटा 3 दिनों बाद हटा दिया जाता है।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanvya · je gegevens worden op je apparaat opgeslagen en veilig gesynchroniseerd. Gastgegevens worden na 3 dagen verwijderd als je je niet registreert."
          }
        }
      }
    },
