    "cashflow:loanNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loans have their own page — add the lender, EMI, tenure and interest, then track EMIs paid and a full month-by-month amortization schedule."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लोन का अपना पेज है — ऋणदाता, ईएमआई, अवधि और ब्याज जोड़ें, फिर भुगतान की गई ईएमआई और पूरा महीने-दर-महीने परिशोधन शेड्यूल ट्रैक करें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leningen hebben hun eigen pagina — voeg de geldverstrekker, EMI, looptijd en rente toe, en volg dan betaalde EMI's en een volledig maand-voor-maand aflossingsschema."
          }
        }
      }
    },
