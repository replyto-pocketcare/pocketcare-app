        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वतः चिह्नित — देय %1$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch gemarkeerd — vervalt %1$@"
          }
