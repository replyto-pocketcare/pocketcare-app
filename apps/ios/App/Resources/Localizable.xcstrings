    "cashflow:intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every recurring income, payment and saving in one place — with an AI projection of where you'll stand in 1, 2 and 3 years."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर आवर्ती आय, भुगतान और बचत एक जगह — साथ में एक AI प्रक्षेपण कि आप 1, 2 और 3 वर्षों में कहाँ खड़े होंगे।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke terugkerende inkomst, betaling en besparing op één plek — met een AI-prognose van waar je over 1, 2 en 3 jaar staat."
