    "loans:autoMarkHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Otherwise you mark each EMI paid yourself. You can change this later."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अन्यथा आप हर ईएमआई स्वयं भुगतान चिह्नित करते हैं। आप इसे बाद में बदल सकते हैं।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anders markeer je elke EMI zelf als betaald. Je kunt dit later wijzigen."
          }
        }
      }
    },
    "loans:autoMarkLabel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-mark EMIs as paid on their due date"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "देय तिथि पर ईएमआई को स्वतः भुगतान चिह्नित करें"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "EMI's automatisch als betaald markeren op hun vervaldag"
          }
        }
      }
    },
    "loans:autoMarkOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You mark each EMI paid yourself. Turn on to auto-mark any EMI whose due date has passed."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप हर ईएमआई स्वयं भुगतान चिह्नित करते हैं। जिस भी ईएमआई की देय तिथि बीत चुकी है उसे स्वतः चिह्नित करने के लिए चालू करें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je markeert elke EMI zelf als betaald. Zet aan om elke EMI waarvan de vervaldag is verstreken automatisch te markeren."
          }
        }
      }
    },
    "loans:autoMarkOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "EMIs are marked paid automatically once their due date passes. Turn off to mark each one yourself."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "देय तिथि बीतते ही ईएमआई स्वतः भुगतान चिह्नित हो जाती हैं। हर एक को स्वयं चिह्नित करने के लिए बंद करें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "EMI's worden automatisch als betaald gemarkeerd zodra hun vervaldag is verstreken. Zet uit om elke EMI zelf te markeren."
          }
        }
      }
    },
    "loans:autoMarkTitle": {
      "extractionState": "manual",
