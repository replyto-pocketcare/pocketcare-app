    "login:registerSub": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create your account to securely sync across all your devices. If you've been exploring as a guest, your data comes with you."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने सभी उपकरणों में सुरक्षित रूप से सिंक करने के लिए अपना खाता बनाएं। यदि आप अतिथि के रूप में देख रहे थे, तो आपका डेटा आपके साथ आता है।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak je account om veilig te synchroniseren op al je apparaten. Als je als gast hebt verkend, gaan je gegevens met je mee."
          }
        }
      }
    },
