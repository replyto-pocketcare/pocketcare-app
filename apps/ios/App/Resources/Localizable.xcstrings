    "settings:deleteAccount": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete account"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खाता हटाएँ"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Account verwijderen"
          }
        }
      }
    },
    "settings:deleteBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently deletes your account and all your data — accounts, transactions, budgets, goals, planned cashflow and more. Your email will be freed so you can register again from scratch. This cannot be undone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आपका खाता और आपका सारा डेटा — खाते, लेनदेन, बजट, लक्ष्य, नियोजित नकदी प्रवाह और अधिक — स्थायी रूप से हटा देता है। आपका ईमेल मुक्त कर दिया जाएगा ताकि आप फिर से नए सिरे से पंजीकरण कर सकें। इसे पूर्ववत नहीं किया जा सकता।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit verwijdert je account en al je gegevens permanent — rekeningen, transacties, budgetten, doelen, geplande cashflow en meer. Je e-mailadres komt vrij zodat je je opnieuw kunt registreren. Dit kan niet ongedaan worden gemaakt."
          }
        }
      }
    },
    "settings:deleteErrDefault": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't delete your account. Please try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका खाता हटाया नहीं जा सका। कृपया पुनः प्रयास करें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kon je account niet verwijderen. Probeer het opnieuw."
          }
        }
      }
    },
