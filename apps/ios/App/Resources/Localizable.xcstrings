    "groups:inviteBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a friend's email. If they're on Sanvya they're added right away; otherwise we'll give you a link to share."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी मित्र का ईमेल दर्ज करें। यदि वे Sanvya पर हैं तो तुरंत जुड़ जाते हैं; अन्यथा हम आपको साझा करने के लिए एक लिंक देंगे।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer het e-mailadres van een vriend in. Als ze op Sanvya zitten, worden ze meteen toegevoegd; anders geven we je een link om te delen."
          }
        }
      }
    },
