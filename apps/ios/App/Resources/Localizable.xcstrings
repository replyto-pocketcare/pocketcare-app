        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ कुछ भी आपके बैंक से नहीं जुड़ता। आप बस यह नाम दे रहे हैं कि पैसा कहाँ रखा है और रकम खुद लिख रहे हैं।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niets hier wordt aan je bank gekoppeld. Je geeft alleen een naam aan een plek waar je geld staat en typt het bedrag zelf in."
