    "assistant:greeting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi! I'm your Sanvya companion. I can help you plan a purchase, set up goals and budgets, make sense of your spending, or split expenses with friends — all from your own data.\n\nHere are a few things you could try:"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नमस्ते! मैं आपका Sanvya साथी हूँ। मैं आपको खरीदारी की योजना बनाने, लक्ष्य और बजट सेट करने, अपने खर्च को समझने, या दोस्तों के साथ खर्च बाँटने में मदद कर सकता हूँ — सब आपके अपने डेटा से।\n\nयहाँ कुछ चीज़ें हैं जो आप आज़मा सकते हैं:"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoi! Ik ben je Sanvya-maatje. Ik kan je helpen een aankoop te plannen, doelen en budgetten in te stellen, je uitgaven te begrijpen, of uitgaven met vrienden te splitsen — allemaal op basis van je eigen gegevens.\n\nHier zijn een paar dingen die je kunt proberen:"
          }
        }
      }
    },
    "assistant:help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Help"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
