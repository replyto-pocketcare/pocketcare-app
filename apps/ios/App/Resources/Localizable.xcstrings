    "recurring:groupDeleteMove": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "It has %1$lld item. Choose where to move it — nothing can be left without a group."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "It has %1$lld items. Choose where to move them — nothing can be left without a group."
                }
