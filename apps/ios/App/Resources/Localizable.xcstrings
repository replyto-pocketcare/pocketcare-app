    "accounts:dueNextCycle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "0 due this cycle — you created this card after the statement day, so %1$@ is due next, on %2$@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस चक्र में 0 देय — आपने यह कार्ड स्टेटमेंट दिन के बाद बनाया, इसलिए %1$@ अगली बार %2$@ को देय है।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "0 te betalen deze cyclus — je hebt deze kaart na de afschriftdag aangemaakt, dus %1$@ is de volgende keer verschuldigd, op %2$@."
          }
        }
      }
    },
    "accounts:dueThisCycle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Due %1$@ on %2$@ (this cycle)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ को देय (इस चक्र में)।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ te betalen op %2$@ (deze cyclus)."
          }
        }
      }
    },
