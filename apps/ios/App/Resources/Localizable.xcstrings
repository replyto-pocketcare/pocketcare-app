    "accounts:deleteAll": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete account & all transactions"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खाता और सभी लेनदेन हटाएँ"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekening en alle transacties verwijderen"
          }
        }
      }
    },
    "accounts:deleteBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can delete this account and all its transactions, or keep the transactions (they will remain in your history but the account will be hidden)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप इस खाते और इसके सभी लेनदेन को हटा सकते हैं, या लेनदेन रख सकते हैं (वे आपके इतिहास में बने रहेंगे पर खाता छिपा दिया जाएगा)।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt deze rekening en al haar transacties verwijderen, of de transacties behouden (ze blijven in je geschiedenis maar de rekening wordt verborgen)."
          }
        }
      }
    },
    "accounts:deleteKeep": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete account but keep transactions"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खाता हटाएँ पर लेनदेन रखें"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekening verwijderen maar transacties behouden"
          }
        }
      }
    },
