    "assistant:premiumBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan purchases and savings in plain language, get concrete numeric plans from your own data, and let it set up goals and budgets for you."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सरल भाषा में खरीदारी और बचत की योजना बनाएं, अपने डेटा से ठोस संख्यात्मक योजनाएँ पाएं, और इसे आपके लिए लक्ष्य और बजट सेट करने दें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan aankopen en sparen in gewone taal, krijg concrete numerieke plannen op basis van je eigen gegevens, en laat het doelen en budgetten voor je instellen."
          }
        }
      }
    },
    "assistant:premiumFeature": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI assistant is a Premium feature"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI असिस्टेंट एक प्रीमियम सुविधा है"
          }
        },
        "nl": {
          "stringUnit": {
