      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Note: this resets your account sign-in password only. If you turned on end-to-end encryption, your encryption passphrase is separate and is not changed here."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नोट: यह केवल आपका खाता साइन-इन पासवर्ड रीसेट करता है। यदि आपने एंड-टू-एंड एन्क्रिप्शन चालू किया है, तो आपका एन्क्रिप्शन पासफ़्रेज़ अलग है और यहाँ नहीं बदला जाता।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Let op: dit stelt alleen je account-aanmeldwachtwoord opnieuw in. Als je end-to-end-encryptie hebt ingeschakeld, staat je encryptie-wachtwoordzin daar los van en wordt die hier niet gewijzigd."
          }
