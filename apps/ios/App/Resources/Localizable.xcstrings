    "receipts:capture.aiNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This sends the photo to our AI reader once. It isn't stored — by us or anyone else."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे फ़ोटो एक बार हमारे AI रीडर को भेजी जाती है। इसे कहीं भी सहेजा नहीं जाता।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee gaat de foto eenmalig naar onze AI-lezer. Hij wordt nergens bewaard."
          }
        }
      }
    },
    "receipts:capture.creditsLeft": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
