    "loans:variableNotePre": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Variable-rate EMIs change over time and can't be auto-calculated, so we'll ask you to "
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "परिवर्तनीय-दर ईएमआई समय के साथ बदलती हैं और स्वतः-गणना नहीं की जा सकतीं, इसलिए हम आपसे कहेंगे कि ऋण के पेज पर "
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "EMI's met variabele rente veranderen na verloop van tijd en kunnen niet automatisch worden berekend, dus vragen we je om "
          }
        }
      }
    },
