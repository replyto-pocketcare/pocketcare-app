      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log your salary, freelance payments and other regular income to see your true monthly inflow."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी सच्ची मासिक आवक देखने के लिए अपना वेतन, फ्रीलांस भुगतान और अन्य नियमित आय दर्ज करें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg je salaris, freelancebetalingen en andere regelmatige inkomsten vast om je echte maandelijkse inkomsten te zien."
          }
        }
      }
    },
    "cashflow:emptyPayments": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add rent, bills, subscriptions and loan EMIs to track everything you're committed to."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिन सब चीज़ों के लिए आप प्रतिबद्ध हैं उन्हें ट्रैक करने के लिए किराया, बिल, सदस्यताएँ और लोन ईएमआई जोड़ें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg huur, rekeningen, abonnementen en EMI's van leningen toe om alles te volgen waar je je aan hebt verbonden."
          }
        }
      }
    },
    "cashflow:emptySavings": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up a recurring saving (a transfer into an investment account), or add individual holdings on the Investments page."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक आवर्ती बचत सेट करें (किसी निवेश खाते में स्थानांतरण), या निवेश पेज पर व्यक्तिगत होल्डिंग्स जोड़ें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel terugkerend sparen in (een overboeking naar een beleggingsrekening), of voeg losse posities toe op de pagina Beleggingen."
          }
        }
      }
    },
