    "loans:chargedToCardHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each EMI will be added to this card when it falls due, and counted in the card's total due."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर EMI देय होने पर इसी कार्ड में जुड़ जाएगी और कार्ड की कुल देय राशि में गिनी जाएगी।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke termijn wordt op deze kaart bijgeschreven zodra hij vervalt, en telt mee in het totaal te betalen bedrag."
          }
        }
      }
    },
    "loans:chargedToHint": {
