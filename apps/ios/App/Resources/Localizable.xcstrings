          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस इमेज को सहेजें, फिर अपने UPI ऐप में “गैलरी से स्कैन करें” का उपयोग करें — या इसे किसी दूसरे डिवाइस से स्कैन करें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sla deze afbeelding op en gebruik “scannen vanuit galerij” in je UPI-app — of scan hem met een ander apparaat."
