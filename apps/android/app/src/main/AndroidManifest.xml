<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Task #62 (Receipt Scan capture): first camera use in this app.
         android:required="false" on the feature: a device with no camera
         should still install the app, just can't use this one screen (same
         posture Google recommends for an optional-camera app). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- Dictation into the assistant's composer. Requested when the mic is
         tapped, never at launch. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!--
      Package visibility, API 30+. Without this SpeechRecognizer cannot SEE the
      recognition service, isRecognitionAvailable() answers false, and the mic
      button silently never appears - which looks exactly like a device with no
      recogniser, and is the failure mode this is easiest to ship by accident.
    -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".SanvyaApplication"
        android:allowBackup="false"
        android:label="PocketCare"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- W1.5 (tablets, foldables, multi-window).

             configChanges: without it, every rotation, fold and split-screen
             drag DESTROYS and recreates the Activity. Compose re-lays-out from
             the new size on its own, so a recreation buys nothing and costs
             everything not explicitly saved. Google's adaptive-apps guidance
             says to handle these rather than be recreated, and it matters most
             on the exact devices this wave is for.

             screenOrientation is deliberately absent: the policy is per device
             type (phones portrait, tablets and foldables free) and lives in
             ui/shell/WindowClass.kt, which the manifest cannot express.

             resizeableActivity is already the default at targetSdk 36; stated
             explicitly so nobody has to look it up to know it is intentional. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            
            <!-- OAuth callback. Google (and any future provider) sends the
                 browser back to `<scheme>://<host>`, and this filter is what
                 routes that URI into MainActivity, which hands it to
                 supabase-kt via handleDeeplinks().

                 Both values are manifest placeholders fed from the
                 `sanvya.authRedirect*` Gradle properties (the same two the
                 Supabase client is configured from), so the URI the app asks
                 the provider to return to and the URI it is registered to
                 receive are the same string by construction.

                 No autoVerify: this is a custom scheme, not an https App Link,
                 so there is no /.well-known file to verify against. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="${authRedirectScheme}"
                    android:host="${authRedirectHost}" />
            </intent-filter>

            <!-- Split invites, the real link. This filter existed before
                 anything consumed it; MainActivity reads the token now.

                 autoVerify only WORKS once
                 https://sanvya.app/.well-known/assetlinks.json carries the
                 release keystore's real SHA-256 fingerprint. It currently
                 carries thirty-two zero bytes, so verification fails, the
                 filter does not bind, and an invite link opens the browser.
                 See docs/mobile/ABSENT-BY-DECISION.md. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="sanvya.app" android:pathPrefix="/join" />
            </intent-filter>

            <!-- The same invite, over the app's own scheme. Needs no
                 server-side anything and works today, which is what makes the
                 join screen testable before the fingerprint above is real:

                     adb shell am start -a android.intent.action.VIEW \
                       -d "com.sanvya.app://join?token=TOKEN"

                 A separate filter rather than another <data> in the OAuth one
                 above: autoVerify and a custom scheme do not belong together,
                 and combining <data> elements would let the OAuth host pair
                 with the https scheme and vice versa. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${authRedirectScheme}" android:host="join" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.PocketCareFirebaseMessagingService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>
