<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Task #62 (Receipt Scan capture): first camera use in this app.
         android:required="false" on the feature: a device with no camera
         should still install the app, just can't use this one screen (same
         posture Google recommends for an optional-camera app). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".SanvyaApplication"
        android:allowBackup="false"
        android:label="PocketCare"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- W1.5 (tablets, foldables, multi-window).

             configChanges: without it, every rotation, fold and split-screen
             drag DESTROYS and recreates the Activity. Compose re-lays-out from
             the new size on its own, so a recreation buys nothing and costs
             everything not explicitly saved. Google's adaptive-apps guidance
             says to handle these rather than be recreated, and it matters most
             on the exact devices this wave is for.

             screenOrientation is deliberately absent: the policy is per device
             type (phones portrait, tablets and foldables free) and lives in
             ui/shell/WindowClass.kt, which the manifest cannot express.

             resizeableActivity is already the default at targetSdk 36; stated
             explicitly so nobody has to look it up to know it is intentional. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            
            <!-- App Links (Deep Links) for Invites -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="sanvya.app" android:pathPrefix="/join" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.PocketCareFirebaseMessagingService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>
