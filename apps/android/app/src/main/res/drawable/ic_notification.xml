<?xml version="1.0" encoding="utf-8"?>
<!--
  The status-bar icon for every Sanvya notification.

  Android renders a notification's small icon as a MASK: every non-transparent
  pixel is painted the system's tint and the colours are thrown away. A launcher
  icon used here comes out as a white blob, which is the single most common way
  this goes wrong — so this is drawn as a solid silhouette on purpose, not as a
  colour version of the app mark.

  A rupee glyph rather than a generic bell: the tray shows it next to a dozen
  other apps' bells, and what the notification is ABOUT is more useful there
  than the fact that it is a notification.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">
